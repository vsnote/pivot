          "type": "text",
          "id": "lgVXj",
          "name": "长内容约定",
          "fill": "$muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "按压缩放仅用于按钮（0.96），不缩放输入框或文本；140ms 背景 / 描边过渡，无旋转；减少动态效果偏好下取消缩放。Tooltip 同时支持悬停与键盘焦点，禁用状态不得依靠透明度作为唯一说明。",
          "fontFamily": "$font",
          "fontSize": 12,
          "fontWeight": "normal"
        }
